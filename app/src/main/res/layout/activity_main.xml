<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B8C6EE"
    android:padding="24dp" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- การ์ดหลัก -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CDD6ED"
            android:padding="20dp"
            android:orientation="vertical"
            android:gravity="center_horizontal" >

            <!-- หัวข้อแอป -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="บันทึกค่าใช้จ่ายประจำวัน"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"
                android:gravity="center" />

            <!-- คำอธิบายย่อย -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="จดทุกบาทที่ใช้วันนี้ให้ครบเลยนะ"
                android:textSize="14sp"
                android:textColor="#2F2F2F"
                android:layout_marginBottom="10dp"
                android:gravity="center" />

            <!-- ลวดลายตกแต่งใต้หัวข้อ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="✧･ﾟ: *✧･ﾟ:* 💰 *:･ﾟ✧*:･ﾟ✧"
                android:textColor="#556699"
                android:textSize="12sp" />


            <!-- ป้ายกำกับจำนวนเงิน -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="โปรดใส่จำนวนเงิน (เป็นบาท)"
                android:textSize="14sp"
                android:textColor="#444444"
                android:layout_marginBottom="8dp"
                android:gravity="center" />

            <!-- ช่องกรอกจำนวนเงิน -->
            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:hint="เช่น 100 หรือ 10.25"
                android:inputType="numberDecimal"
                android:padding="14dp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <!-- ป้ายกำกับคำอธิบาย -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="คำอธิบาย"
                android:textSize="14sp"
                android:textColor="#444444"
                android:layout_marginBottom="8dp"
                android:gravity="center" />

            <!-- ช่องกรอกคำอธิบาย -->
            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:hint="เช่น ข้าวกลางวัน, ค่าเดินทาง"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:textSize="16sp"
                android:layout_marginBottom="20dp" />

            <!-- ปุ่ม (เคลียร์ / เพิ่มรายการ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="เคลียร์"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#396BFA" />

                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="เพิ่มรายการ"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0C126A" />
            </LinearLayout>

            <!-- เส้นแบ่ง -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000"
                android:layout_marginBottom="20dp" />

            <!-- รายการล่าสุด -->
            <TextView
                android:id="@+id/tvLatest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="รายการล่าสุด: -"
                android:textSize="15sp"
                android:textColor="#444444"
                android:layout_marginBottom="8dp" />

            <!-- ยอดรวมวันนี้ -->
            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ยอดรวมวันนี้: 0.00 บาท"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginBottom="12dp" />

            <!-- ลวดลายตกแต่งด้านล่างสุด -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="🌸 🍃 🌸 🍃 🌸 🍃 🌸"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
